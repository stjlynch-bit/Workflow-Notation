        <semantic:dataObject id="_c4b91ba5-5fc1-45ef-90a0-3447f4ba1f6b" name="Picking List" triso:readOnly="false" itemSubjectRef="_7d50791c-975a-41a1-aeac-bdc4296d243a" isCollection="false">
            <semantic:documentation>&lt;p&gt;A list of items that need to be picked for the order.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:reuseLink id="_8708f7fd-529b-4e5c-8b0d-5199dd22672d" modelName="Logistics Management Entity Model" itemName="Picking List" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_5bc4cf75-d605-444a-827a-00f623ad9cfc" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
                <triso:notes>&lt;p&gt;&lt;strong&gt;Usage&lt;/strong&gt;: Guides the warehouse staff on what items to pick.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_3f491cb0-61a2-426f-b129-03ef0c397599" name="Product" triso:readOnly="false" itemSubjectRef="_25b41811-f2ef-4113-8537-d361da76bc83" isCollection="false">
            <semantic:documentation>&lt;p&gt;A Product is an item stored in the warehouse, ready to be sold or shipped. Each product has attributes like a unique identifier (ProductID), name, description, category, price, and weight. Products can be classified into different types such as perishable, non-perishable, or fragile.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:reuseLink id="_5bc648cf-1213-4b93-a2de-2263bfe1f32d" modelName="Logistics Management Entity Model" itemName="Product" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_266c720b-4bc8-4eb1-97ca-05a0779ada20" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>

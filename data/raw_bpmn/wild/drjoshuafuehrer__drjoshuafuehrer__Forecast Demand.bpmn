        </semantic:startEvent>
        <semantic:dataObject id="_9438f327-c5f5-4431-9b02-a853c6ab7947" name="Promotional Activity Information" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Information on marketing and promotional activities.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Promotion ID, product ID, promotion start date, promotion end date, discount rate.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_2eee3007-d6db-41b5-836a-ffb56ae5f716" name="External Factor Data" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Information on external factors influencing demand.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Economic indicators, weather data, regulatory changes.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_bb2059b6-0646-48b4-8305-8d732d3ea010" name="Order" triso:readOnly="false" itemSubjectRef="_70117066-9707-4e97-a05c-2f6a0d81e18b" isCollection="false">
            <semantic:documentation>&lt;p&gt;An Order is a request for products made by a customer. Each order has attributes like a unique identifier (Order ID), order date, customer name, and total amount. Orders detail the products requested by customers and are essential for tracking sales and fulfillment.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:reuseLink id="_6530b331-d1e1-4f03-9a10-703fa062c1ec" modelName="Logistics Management Entity Model" itemName="Order" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b54bbf53-9337-48b7-a572-67b15d181b59" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_dc574265-f538-4aa9-97ea-4b78ec5d5dd8" name="Supplier Information" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Details about suppliers.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Supplier ID, lead time, order quantities, delivery performance.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_6f752f95-f11c-4799-8e37-039021cf469d" name="Inventory Levels" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Current stock levels of products.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Product ID, quantity in stock, reorder point, safety stock level.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_78d6ffc6-a9fc-4e58-b024-3ba52a8cfd8b" name="Historical sales data" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Records of past sales transactions.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Date, product ID, quantity sold, sales price, customer ID.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_dbbefc00-94fc-4884-9d37-e5951e371a37" name="Market trend data" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Information on market trends affecting demand.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Market growth rates, economic indicators, competitor actions.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
